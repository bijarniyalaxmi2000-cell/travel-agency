<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Not_Exceed_Balance</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISPICKVAL(Payment_Type__c, &quot;Refund&quot;)), Amount__c &gt; (Booking__r.Total_Amount__c - Booking__r.Amount_Paid__c))</errorConditionFormula>
    <errorMessage>Payment amount exceeds the remaining balance on this booking.</errorMessage>
</ValidationRule>
