<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Commission_Partner_Must_Be_Agency</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISPICKVAL(Partner_Account__r.Client_Type__c, &quot;Partner Agency&quot;))</errorConditionFormula>
