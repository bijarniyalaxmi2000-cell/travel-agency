<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Passport_Expiry_Check</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
					NOT(
									ISBLANK(Passport_Expiry_Date__c)
					), 
					Passport_Expiry_Date__c &lt; TODAY()
	)</errorConditionFormula>
    <errorDisplayField>Passport_Expiry_Date__c</errorDisplayField>
    <errorMessage>Passport has already expired — update the passport details before saving.</errorMessage>
</ValidationRule>
